(in-package :maxima)
(handler-case
    (let* ((source (ext:getenv "CTM_FIXTURE_SOURCE"))
           ($packagefile (equal (ext:getenv "CTM_FIXTURE_PACKAGE") "true"))
           (bridge (equal (ext:getenv "CTM_FIXTURE_BRIDGE") "true"))
           (original (get '$display2d 'assign))
           (result nil))
      (when bridge
        (unless (functionp original) (error "Expected a compiled assignment hook"))
        (load (ext:getenv "CTM_FIXTURE_BRIDGE_FILE"))
        (setf (get '$display2d 'assign) 'ctm-display2d-bridge))
      (unwind-protect
           (unless (eq (catch 'macsyma-quit
                         (setf result (translate-file source nil))
                         :completed)
                       :completed)
             (error "Maxima aborted fixture translation"))
        (setf (get '$display2d 'assign) original))
      (unless (eq original (get '$display2d 'assign))
        (error "Assignment hook was not restored"))
      (unless (and (listp result) (= (length result) 4)
                   (equal (first result) '(mlist))
                   (equal (third result)
                          (namestring (make-pathname :defaults source :type "LISP"))))
        (error "Unexpected fixture translation result"))
      (with-standard-io-syntax
        (let ((*package* (find-package :maxima)) (*read-eval* nil)
              (eof (gensym)) (forms 0) (props nil))
          (labels ((mentions-props (form)
                     (if (atom form) (eq form '$props)
                         (or (mentions-props (car form)) (mentions-props (cdr form))))))
            (with-open-file (stream (third result))
              (loop for form = (read stream nil eof) until (eq form eof)
                    do (incf forms) (when (mentions-props form) (setf props t)))))
          (unless (plusp forms) (error "Empty fixture translation"))
          (when (and $packagefile props) (error "Package fixture still registers props"))
          (format t "~&CTM-FIXTURE-TRANSLATION-OK|forms=~D|package=~S|props=~S~%"
                  forms $packagefile props)))
      (finish-output)
      (bye 0))
  (error (condition)
    (let ((*print-readably* nil))
      (format *error-output* "~&CTM-FIXTURE-TRANSLATION-FAILED|~A~%" condition)
      (finish-output *error-output*))
    (bye 1)))
