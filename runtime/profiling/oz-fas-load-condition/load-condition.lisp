;; Diagnostic only. No function-cell interposition or condition suppression.
(when (find-package "CTM-LOAD-CONDITION")
  (error "Diagnostic condition package already exists"))
(defpackage #:ctm-load-condition (:use #:cl))
(in-package #:ctm-load-condition)
(defun json-string (value stream)
  (write-char #\" stream)
  (loop for ch across value do
    (case ch
      (#\" (write-string "\\\"" stream))
      (#\\ (write-string "\\\\" stream))
      (#\Newline (write-string "\\n" stream))
      (#\Return (write-string "\\r" stream))
      (#\Tab (write-string "\\t" stream))
      (otherwise (if (< (char-code ch) 32)
                     (format stream "\\u~4,'0X" (char-code ch))
                     (write-char ch stream)))))
  (write-char #\" stream))
(defun emit-condition (condition)
  (let* ((*print-length* 12) (*print-level* 4) (*print-circle* t)
         (*print-readably* nil)
         (type (princ-to-string (type-of condition)))
         (report (handler-case (princ-to-string condition)
                   (error () "Condition report unavailable")))
         (truncated (> (length report) 2048)))
    (format *standard-output* "~&CTM-LOAD-CONDITION|{\"schema\":1,\"kind\":\"maxima-root-load-condition\",\"errset\":true,\"type\":")
    (json-string (subseq type 0 (min 128 (length type))) *standard-output*)
    (write-string ",\"report\":" *standard-output*)
    (json-string (subseq report 0 (min 2048 (length report))) *standard-output*)
    (format *standard-output* ",\"reportTruncated\":~A}~%" (if truncated "true" "false"))
    (finish-output *standard-output*)))
(defun run (root)
  (unless (equal root "/ctm/moodle-qtype_stack-master/stack/maxima/stacklocallinux.mac")
    (error "Unexpected diagnostic root path"))
  (let ((maxima::errset t) (reported nil))
    (format *standard-output* "~&CTM-LOAD-CONDITION-ARMED~%")
    (finish-output *standard-output*)
    (handler-bind
        ((error (lambda (condition)
                  (unless reported
                    (setf reported t)
                    (handler-case (emit-condition condition)
                      (error ()
                        (handler-case
                            (progn (format *standard-output* "~&CTM-LOAD-CONDITION-LOGGER-FAILED~%")
                                   (finish-output *standard-output*))
                          (error () nil))))))))
      ;; A returning handler declines the condition; original propagation continues.
      (maxima::$load root))))
