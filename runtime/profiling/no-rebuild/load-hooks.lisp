(let* ((profile-package (or (find-package "CTM-PROFILE") (make-package "CTM-PROFILE" :use nil)))
       (stream *standard-output*) (serial 0) (parent 0) (depth 0)
       (observed 0) (dropped 0) (observer-errors 0) (maximum 512) (originals nil)
       (units internal-time-units-per-second)
       (initial-real (get-internal-real-time)) (initial-run (get-internal-run-time)))
  (labels
      ((json-string (value)
         (let ((text (if (stringp value) value (princ-to-string value))))
           (with-output-to-string (out)
             (write-char #\" out)
             (loop for ch across (subseq text 0 (min 512 (length text))) do
               (case ch
                 (#\" (write-string "\\\"" out))
                 (#\\ (write-string "\\\\" out))
                 (#\Newline (write-string "\\n" out))
                 (#\Return (write-string "\\r" out))
                 (#\Tab (write-string "\\t" out))
                 (otherwise (if (< (char-code ch) 32)
                                (format out "\\u~4,'0x" (char-code ch))
                                (write-char ch out)))))
             (write-char #\" out))))
       (emit (body)
         (handler-case (progn (format stream "~&CTM-PROFILE|~a~%" body) (finish-output stream))
           (error () (incf observer-errors))))
       (argument-name (args)
         (let ((value (first args)))
           (cond ((pathnamep value) (namestring value))
                 ((or (stringp value) (symbolp value)) (princ-to-string value))
                 (t (format nil "<~a>" (type-of value))))))
       (wrap (symbol label)
         (when (fboundp symbol)
           (let* ((original (symbol-function symbol))
                  (wrapper
                    (lambda (&rest args)
                      (let ((id (incf serial)) (old-parent parent) (old-depth depth)
                            (real (get-internal-real-time)) (run (get-internal-run-time))
                            (completed nil) (name (argument-name args)))
                        (setf parent id depth (1+ old-depth))
                        (unwind-protect
                             (multiple-value-prog1 (apply original args) (setf completed t))
                          (let ((end-real (get-internal-real-time)) (end-run (get-internal-run-time)))
                            (setf parent old-parent depth old-depth)
                            (handler-case
                                (if (< observed maximum)
                                    (progn
                                      (incf observed)
                                      (emit (format nil "{\"kind\":\"lisp-call\",\"id\":~d,\"parent\":~d,\"depth\":~d,\"operation\":~a,\"name\":~a,\"completed\":~a,\"realStart\":~d,\"realEnd\":~d,\"runStart\":~d,\"runEnd\":~d,\"units\":~d}"
                                                    id old-parent old-depth (json-string label) (json-string name)
                                                    (if completed "true" "false") real end-real run end-run units)))
                                    (incf dropped))
                              (error () (incf observer-errors)))))))))
             (setf (symbol-function symbol) wrapper)
             (push (list symbol original wrapper) originals)))))
    (emit (format nil "{\"kind\":\"lisp-clock-start\",\"realTicks\":~d,\"runTicks\":~d,\"units\":~d}" initial-real initial-run units))
    (let ((r0 (get-internal-real-time)) (c0 (get-internal-run-time)) (checksum 0))
      (dotimes (i 20000) (setf checksum (logxor checksum i)))
      (emit (format nil "{\"kind\":\"lisp-clock-calibration\",\"realTicks\":~d,\"runTicks\":~d,\"units\":~d,\"checksum\":~d}"
                    (- (get-internal-real-time) r0) (- (get-internal-run-time) c0) units checksum)))
    (wrap (find-symbol "$LOAD" "MAXIMA") "maxima-load")
    (wrap 'cl:load "cl-load")
    (let ((symbol (find-symbol "$COMPILE" "MAXIMA"))) (when symbol (wrap symbol "maxima-compile")))
    (setf (symbol-function (intern "FINISH" profile-package))
          (lambda ()
            (let ((restored 0) (changed 0))
              (dolist (entry originals)
                (if (eq (symbol-function (first entry)) (third entry))
                    (progn (setf (symbol-function (first entry)) (second entry)) (incf restored))
                    (incf changed)))
              (emit (format nil "{\"kind\":\"lisp-finish\",\"observed\":~d,\"dropped\":~d,\"observerErrors\":~d,\"restored\":~d,\"changedFunctions\":~d,\"realTicks\":~d,\"runTicks\":~d,\"units\":~d}"
                            observed dropped observer-errors restored changed
                            (get-internal-real-time) (get-internal-run-time) units)))))))
