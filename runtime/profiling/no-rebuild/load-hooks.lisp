;; Use the pinned ECL tracer, whose recursive LOAD tracing already has retained
;; browser evidence. Do not interpose CL:LOAD or call ECL timing primitives.
(let* ((package (or (find-package "CTM-PROFILE")
                    (make-package "CTM-PROFILE" :use nil)))
       (stream *standard-output*)
       (original-output *trace-output*)
       (original-function (fdefinition 'maxima::$load)))
  (when (member 'maxima::$load (trace))
    (error "Diagnostic LOAD tracing was already active"))
  (setf *trace-output* stream)
  (trace maxima::$load)
  (unless (member 'maxima::$load (trace))
    (error "Diagnostic LOAD tracing did not activate"))
  (setf (symbol-function (intern "FINISH" package))
        (lambda ()
          (untrace maxima::$load)
          (let ((restored (and (not (member 'maxima::$load (trace)))
                               (eq original-function (fdefinition 'maxima::$load)))))
            (setf *trace-output* original-output)
            (format stream "~&CTM-PROFILE|{\"kind\":\"trace-finish\",\"restored\":~a}~%"
                    (if restored "true" "false"))
            (finish-output stream))))
  (format stream "~&CTM-PROFILE|{\"kind\":\"trace-start\",\"active\":true,\"method\":\"ECL TRACE MAXIMA::$LOAD\"}~%")
  (finish-output stream))
